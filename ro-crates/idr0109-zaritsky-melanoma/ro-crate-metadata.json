    {
      "@id": "#specimen-imaging-preparation-protocol-idr0109-zaritsky-melanoma-experimenta",
      "@type": "bia:SpecimenImagingPreparationProtocol",
      "name": "Specimen imaging preparation protocol",
      "description": "Cell cultures were grown on polystyrene tissue culture dishes to confluence at 37°C and 5% CO2. Melanoma cells derived from murine PDX models were gifts from Sean Morrison (UT Southwestern Medical Center, Dallas, TX) and cultured in medium containing the Melanocyte Growth Kit and Dermal Cell Basal Medium from ATCC. Primary melanocytes were obtained from ATCC (PCS-200-013) and grown in medium containing the Melanocyte Growth Kit and Dermal Cell Basal Medium from ATCC. The m116 melanocytes, a gift from J. Shay (UT Southwestern Medical Center, Dallas), were derived from fetal foreskin and were cultured in medium 254 (Fisher). A375 cells were obtained from ATCC (CRL-1619). SK-Mel2 cells were obtained from ATCC (HTB-68). MV3 cells were a gift from Peter Friedl (MD Anderson Cancer Center, Houston, TX). MV3 and A375 cells were cultured in DMEM with 10% FBS. WM3670, WM1361, and WM1366 were obtained directly from the Wistar Institute and cultured in the recommended medium (80% MCDB1653, 20%, 2% FBS, CaCl2 and bovine insulin)."
    },
    {
      "@id": "https://doi.org/10.1016/j.cels.2021.05.003",
      "@type": "bia:Publication",
      "name": "Interpretable deep learning uncovers cellular properties in label-free live cell images that are predictive of highly metastatic melanoma",
      "doi": "https://doi.org/10.1016/j.cels.2021.05.003",
      "pubmedId": "34077708",
      "authorNames": "Zaritsky A, Jamieson AR, Welf ES, Nevarez A, Cillay J, Eskiocak U, Cantarel BL, Danuser G"
    },
